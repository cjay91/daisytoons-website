# Settings for the live shop. Copy to deploy/.env on the server and fill in every value.
# Never commit deploy/.env. Generate secrets with: openssl rand -hex 32

# Domains (each needs a DNS A record pointing at the server)
SHOP_DOMAIN=daisytoons.lk
CONSOLE_DOMAIN=console.daisytoons.lk
API_DOMAIN=api.daisytoons.lk
# For Let's Encrypt expiry notices
ACME_EMAIL=you@example.com

POSTGRES_PASSWORD=
JWT_SECRET=

# Product photos: a public bucket (Cloudflare R2 shown; any S3-compatible store works)
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=daisytoons-images
# The bucket's public address (an R2 custom domain such as images.daisytoons.lk)
S3_PUBLIC_BASE_URL=https://images.daisytoons.lk

# Backups: a second, private bucket, with its own key that can only write to it
BACKUP_BUCKET=daisytoons-backups
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_KEEP_DAYS=30
# Optional: a healthchecks.io ping URL, so you're alerted if a night's backup doesn't happen
BACKUP_PING_URL=

# PayHere live merchant account (Settings > Domains & Credentials)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=false

# Email sending (an SMTP service such as Brevo, Postmark, Amazon SES or Zoho Mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=Daisytoons <orders@daisytoons.lk>
# Shown on the shop's policy pages and footer
SHOP_EMAIL=orders@daisytoons.lk

# Optional: error tracking (sentry.io project DSN)
SENTRY_DSN=
