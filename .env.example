# Copy to .env and adjust. Never commit .env.

# Postgres (used by the db container and the API)
POSTGRES_USER=daisytoons
POSTGRES_PASSWORD=daisytoons
POSTGRES_DB=daisytoons

# API settings (read by backend/app/config.py)
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://daisytoons:daisytoons@db:5432/daisytoons
REDIS_URL=redis://redis:6379/0

# Signs login tokens. Use a long random value outside local development:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-in-production

# Product image storage (S3-compatible). Locally this is the storage service in Compose.
S3_ENDPOINT_URL=http://storage:8333
S3_BUCKET=daisytoons-images
# The address browsers load images from.
S3_PUBLIC_BASE_URL=http://localhost:8333/daisytoons-images

# Public addresses, used in payment and email links.
API_PUBLIC_URL=http://localhost:8000
STOREFRONT_URL=http://localhost:3000

# Payments. "fake" is a built-in stand-in gateway for local development; production uses
# "payhere" with the merchant ID and secret from the PayHere dashboard.
PAYMENT_PROVIDER=fake
PAYHERE_MERCHANT_ID=1200000
PAYHERE_MERCHANT_SECRET=dev-only-payhere-secret
PAYHERE_SANDBOX=true

# Charges in rupees, and how long checkout holds stock for an unpaid order.
DELIVERY_FEE_COLOMBO=400
DELIVERY_FEE_OTHER=650
FREE_DELIVERY_OVER=10000
GIFT_WRAP_FEE=250
RESERVATION_MINUTES=30

# Outgoing email. Locally Compose points this at Mailpit (http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=Daisytoons <orders@daisytoons.lk>

# Staff must use two-step login (an authenticator app). Required to be true in production.
REQUIRE_STAFF_TWO_FACTOR=false

# Agents (Part 8). Without a key, agents only run against the scripted model in tests.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5

# Error tracking. Leave empty to turn it off. The web apps read the same variable.
SENTRY_DSN=

# Storefront (frontend/), read by Next.js. Set these in frontend/.env.local or the host.
#   API_URL=http://localhost:8000          where the storefront's server reaches the API
#   SITE_URL=http://localhost:3000         the public address, for links and the sitemap
#   IMAGE_BASE_URL=http://localhost:8333/daisytoons-images   same as S3_PUBLIC_BASE_URL
#   SHOP_EMAIL=orders@daisytoons.lk        the contact address on the policy pages

# Staff console (console/), read by Next.js. Set these in console/.env.local or the host.
#   API_URL=http://localhost:8000          where the console's server reaches the API
#   STOREFRONT_URL=http://localhost:3000   for the link to a customer's order page
#   IMAGE_BASE_URL=http://localhost:8333/daisytoons-images   same as S3_PUBLIC_BASE_URL
